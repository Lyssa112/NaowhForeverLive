# Claude Code's local settings, worktrees and notes.
/.claude/

__pycache__/
*.pyc

# Written by the release workflow for the packager.
/RELEASE_NOTES.md

# Fetched by the packager from .pkgmeta externals; only the loader is ours.
/Libs/*
!/Libs/embeds.xml

# The data tools live in the private NaowhForever-data repository, which overlays its Tools/ here.
/Tools/*
!/Tools/paths.py
!/Tools/regression/
!/Tools/hooks/
/Tools/hooks/daily-pull-request.sh
!/Tools/release/
/Tools/release/watch_build.py
!/Tools/build/
/Tools/build/*
!/Tools/build/auction_feed.py
!/Tools/build/presets.lua
!/Tools/build/rxp_contract.py
!/Tools/build/search_index.lua
!/Tools/tests/
/Tools/tests/*
!/Tools/tests/test_auction_feed.py
!/Tools/tests/test_release.py
!/Tools/tests/test_rxp_contract.py
!/Tools/tests/test_sync_badges.py
/Tools/regression/test-damage-meter.lua
